# ---- Build Stage ----
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY frontend/package.json frontend/package-lock.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY frontend/ .

# Build-time env vars (will be baked into the client bundle)
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_ASSET_BASE_URL
# NOTE: the RapidAPI KEY is deliberately absent here. It is read at RUNTIME as
# `RAPIDAPI_KEY` by app/api/live-timing/route.ts. A `NEXT_PUBLIC_` key would be
# inlined into the client bundle at build time and readable in View Source.
ARG NEXT_PUBLIC_RAPIDAPI_HOST
# The f1-agent service (Batch 17). Separate from the API base URL because it is
# a separate Cloud Run service with its own scaling and timeout settings.
ARG NEXT_PUBLIC_AGENT_BASE_URL
# The GA4 measurement ID. Baked into the client bundle, which is correct and
# not a leak: a measurement ID is a public identifier, visible in View Source
# on every site that uses GA. Empty is a supported value -- the analytics
# components render nothing without it, so a build with no ID is today's site.
ARG NEXT_PUBLIC_GA_MEASUREMENT_ID
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_ASSET_BASE_URL=$NEXT_PUBLIC_ASSET_BASE_URL
ENV NEXT_PUBLIC_RAPIDAPI_HOST=$NEXT_PUBLIC_RAPIDAPI_HOST
ENV NEXT_PUBLIC_AGENT_BASE_URL=$NEXT_PUBLIC_AGENT_BASE_URL
ENV NEXT_PUBLIC_GA_MEASUREMENT_ID=$NEXT_PUBLIC_GA_MEASUREMENT_ID

# Build the Next.js app
RUN npm run build

# ---- Production Stage ----
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Copy standalone output
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

# Copy public assets (drivers, flags for local fallback)
COPY --from=builder /app/public ./public

EXPOSE 3000

CMD ["node", "server.js"]
