# Use lightweight Python image
FROM python:3.11-slim

# Install system dependencies if needed
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

# Set working directory inside container
WORKDIR /app

# Copy requirements and install
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend app code
COPY backend/app ./app

# The curated CircuitSpec list, read at runtime by app/track_geometry.py to
# decide which circuits are buildable. Copied as a single file on purpose: it
# imports nothing but `dataclasses`, while its siblings in scripts/trackgeo pull
# in numpy/scipy, so only this one module belongs in the API image. The path
# mirrors the repo layout (`<root>/scripts/trackgeo/curated.py`) so the loader's
# walk-up resolves identically in the container and in a dev checkout.
COPY scripts/trackgeo/curated.py ./scripts/trackgeo/curated.py

# Disable output buffering (useful for logs in Cloud Run)
ENV PYTHONUNBUFFERED=1

# FastF1 needs a writable cache dir; only /tmp is writable on Cloud Run.
ENV FASTF1_CACHE_DIR=/tmp/f1_cache

# Expose port (default for FastAPI/uvicorn)
EXPOSE 8000

# Run the FastAPI app using uvicorn
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
